                <mxCell id="575" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;finaliza&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;viaje&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-size: 10px; background-color: transparent;&quot;&gt;ruta 2 11&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;llega a&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;destino&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="703.5" y="2944" width="57" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="577" value="&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot; color=&quot;#000000&quot;&gt;Se desea modelar con una red de Petri el funcionamiento de los servicios de spa de un hotel.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;Los huéspedes llegan al spa del hotel y, antes de realizar cualquier tratamiento, deben registrarse.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;El spa dispone de dos empleados para el registro, que pueden atender a un huésped a la vez,&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;en cualquiera&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font size=&quot;3&quot;&gt;de las dos mesas de registración. Una vez registrados, los clientes se dirigen a un área de espera común.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;Se pueden utilizar dos circuitos diferentes de tratamiento:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;Circuito A: Tratamientos corporales&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;Los huéspedes que utilizan este circuito pasan primero por una sala que posee dos puestos de masajes,&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;con dos terapeutas que pueden atender simultáneamente, pero no a más de un huésped a la vez cada uno.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;Cada terapeuta siempre trabaja en el mismo puesto de masajes.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;Luego del masaje, los huéspedes se dirigen hacia la sala de meditación, la cual solo se abre cuando&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;hay exactamente 5 personas listas para la sesión. La meditación se realiza en grupo y la sala no puede&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;utilizarse hasta que la sesión termine.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;Al finalizar, los huéspedes pasan a un área de descanso común para luego retirarse del spa.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;Circuito B: Circuito hídrico&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;Los huéspedes que utilizan este circuito se dirigen al área de hidromasaje, la cual dispone de una bañera&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;con capacidad para hasta 4 personas. Luego del hidromasaje, los huéspedes también se dirigen al área de&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; color=&quot;#000000&quot;&gt;descanso común para luego retirarse del spa.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="18" y="3191" width="792" height="377" as="geometry"/>
                </mxCell>
                <mxCell id="578" value="&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;ENUNCIADO PARCIAL 2:&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="4.5" y="3165" width="182" height="26" as="geometry"/>
                </mxCell>
